name = "dowdiness/rabbita_markdown"

version = "0.1.0"

import {
  "moonbit-community/rabbita@0.15.4",
  "moonbitlang/async@0.22.1",
  "dowdiness/loom@0.1.0",
  "dowdiness/markdown@0.1.0",
  "dowdiness/text_change@0.1.0",
}

readme = "README.md"

