import {
  "moonbitlang/core/json",
  "moonbitlang/core/math",
  "moonbitlang/core/ref",
  "dowdiness/canopy-canvas-graph/graph_model",
  "dowdiness/canvas-spatial" @spatial,
  "dowdiness/canvas-layout/skyline" @layout,
  "dowdiness/incr",
  "dowdiness/graph-dsl" @graph_dsl,
  "dowdiness/loom/core",
  "dowdiness/rabbita_codemirror" @codemirror,
  "dowdiness/rabbita-context-menu/context_menu",
  "dowdiness/rabbita-status/status",
  "moonbit-community/rabbita",
  "moonbit-community/rabbita/cmd",
  "moonbit-community/rabbita/dom",
  "moonbit-community/rabbita/html",
  "moonbit-community/rabbita/js",
  "moonbit-community/rabbita/sub",
  "moonbit-community/rabbita/svg",
}

import {
  "moonbitlang/core/debug",
  "moonbit-community/rabbita/testing" @rabbita_testing,
  "moonbitlang/async",
} for "wbtest"

// Keep this package JS-only until `defer_sync` in `source_demo.mbt` has a
// non-JS implementation with the same post-mutation defer ordering as browser
// `queueMicrotask`; a synchronous fallback reintroduces stale source reads.

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "create_canvas",
        "mount_canvas_ui",
        "publish_render_state",
        "get_render_state",
        "get_action_log",
        "create_source_graph",
        "destroy_source_graph",
        "try_destroy_source_graph",
        "get_source_graph_source",
        "get_source_graph_render_state",
        "get_source_graph_action_log",
        "sample_graph_dsl_source",
      ],
    },
  },
)
