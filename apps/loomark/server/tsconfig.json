{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/vitest-plugin/types", "vite/client"]
  },
  "include": ["./**/*.ts", "../vitest.server.config.ts"],
  "exclude": ["generate-auth-schema.mts"]
}
