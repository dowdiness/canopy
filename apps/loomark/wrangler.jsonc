{
  // Loomark editor assets and same-origin account API.
  //
  // Lives at apps/loomark/ (not the repository root) because Wrangler >=3.114
  // discovers configs by walking up from the cwd and prefers wrangler.jsonc
  // over wrangler.toml: a repository-root wrangler.jsonc shadows every
  // subdirectory wrangler.toml (e.g. apps/relay-server's). The Cloudflare Git
  // integration for this worker must set its root directory to apps/loomark
  // so that `npx wrangler deploy` finds this file. The custom build keeps the
  // external Workers Build on the same MoonBit/Warren bootstrap as CI.
  "name": "loomark",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "loomark-auth",
      "migrations_dir": "server/migrations"
    }
  ],
  "build": {
    "command": "../../scripts/build-loomark-worker.sh"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
