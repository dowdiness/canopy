import {
  "moonbit-community/rabbita",
  "moonbit-community/rabbita/cmd",
  "moonbit-community/rabbita/html",
}

supported_targets = "js"

options(
  "pre-build": [
    {
      "input": "documents/welcome.md",
      "output": "example_welcome.g.mbt",
      "command": ":embed --text -i $input -o $output --name embedded_welcome_source",
    },
    {
      "input": "documents/markdown.md",
      "output": "example_markdown.g.mbt",
      "command": ":embed --text -i $input -o $output --name embedded_markdown_source",
    },
    {
      "input": "documents/journal.md",
      "output": "example_journal.g.mbt",
      "command": ":embed --text -i $input -o $output --name embedded_journal_source",
    },
  ],
)
