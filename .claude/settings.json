{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "test -f scripts/stop-phrase-guard.sh && bash scripts/stop-phrase-guard.sh || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(moon check *)",
      "Bash(moon test *)",
      "Bash(moon ide *)",
      "Bash(moon bench *)"
    ]
  }
}
