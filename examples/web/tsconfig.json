{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@moonbit/crdt-lambda": ["../../_build/js/release/build/dowdiness/canopy/ffi/lambda/lambda.d.ts"],
      "@moonbit/crdt-lambda/moonbit": ["../../_build/js/release/build/dowdiness/canopy/ffi/lambda/moonbit.d.ts"],
      "@moonbit/crdt-json": ["../../_build/js/release/build/dowdiness/canopy/ffi/json/json.d.ts"],
      "@moonbit/crdt-json/moonbit": ["../../_build/js/release/build/dowdiness/canopy/ffi/json/moonbit.d.ts"],
      "@moonbit/crdt-markdown": ["../../_build/js/release/build/dowdiness/canopy/ffi/markdown/markdown.d.ts"],
      "@moonbit/crdt-markdown/moonbit": ["../../_build/js/release/build/dowdiness/canopy/ffi/markdown/moonbit.d.ts"],
      "@moonbit/crdt-jsx": ["../../_build/js/release/build/dowdiness/canopy/ffi/jsx/jsx.d.ts"],
      "@moonbit/crdt-jsx/moonbit": ["../../_build/js/release/build/dowdiness/canopy/ffi/jsx/moonbit.d.ts"],
      "@moonbit/graphviz": ["../../_build/js/release/build/dowdiness/graphviz/browser/browser.d.ts"]
    }
  },
  "include": [
    "src/**/*",
    "waku.config.ts",
    "moonbit-artifacts.d.mts"
  ],
  "exclude": [
    "node_modules",
    "../../_build",
    "src/waku.server.tsx"
  ]
}
